# Backend (Vercel > Settings > Environment Variables). Nunca use o prefixo VITE_ nestes valores.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SALEZ_WEBHOOK_SECRET=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Origens de navegador autorizadas a chamar /api/ai, separadas por vírgula (vazio = só mesma origem)
ALLOWED_ORIGINS=

# Frontend (públicas por natureza)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Salez CRM Integration (Opcional)
SALEZ_API_KEY=
SALEZ_AGENT_ID=agt_cs_onboarding_v1

# Cron (Vercel envia Authorization: Bearer $CRON_SECRET)
CRON_SECRET=

# Hosts permitidos para o passo http_request das automações (separados por vírgula). Vazio = nenhum.
AUTOMATION_HTTP_ALLOWLIST=

# Telemetria da plataforma de beneficios -> POST /api/ingest/metrics (cabecalho x-ingest-secret)
INGEST_SECRET=
